{
  "baseURL": "https://408cake.github.io/408cake/",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ]
}
